cc_library_static {
    name: "libudfps_extension.oplus",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include",
    ],
    cflags:
        select(soong_config_variable("ANDROID", "DeviceName"), {
        "aston": ["-DBUILD_ASTON"],
        default: []
    })
    header_libs: [
        "generated_kernel_headers",
    ],
}
